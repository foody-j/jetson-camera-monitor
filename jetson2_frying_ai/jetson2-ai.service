[Unit]
Description=Jetson #2 Frying AI Monitoring System
After=network.target graphical.target sensing-camera.service
Wants=graphical.target sensing-camera.service

[Service]
Type=simple
User=hr_dku_002
Group=hr_dku_002
WorkingDirectory=/home/hr_dku_002/jetson-food-ai/jetson2_frying_ai
Environment="DISPLAY=:0"
Environment="XAUTHORITY=/home/hr_dku_002/.Xauthority"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/python3 /home/hr_dku_002/jetson-food-ai/jetson2_frying_ai/JETSON2_INTEGRATED.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security and resource limits
Nice=-10
IOSchedulingClass=realtime
IOSchedulingPriority=0

[Install]
WantedBy=graphical.target
